#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
apt-get install -y ca-certificates curl python3
curl --fail --silent --show-error --location https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg
curl --fail --silent --show-error --location https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list
apt-get update -q
apt-get install -y tailscale
cat >/etc/sysctl.d/99-tailscale.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
SYSCTL
sysctl -p /etc/sysctl.d/99-tailscale.conf
systemctl enable --now tailscaled
# The Google token and Tailscale auth key stay out of Terraform, metadata,
# command arguments, and persistent files. /run is a memory-backed filesystem.
python3 - <<'PY'
import base64
import json
import os
import subprocess
import tempfile
import urllib.request

command = ['tailscale', 'up', '--hostname=${hostname}', '--advertise-routes=${routes}',
           '--snat-subnet-routes=true', '--accept-dns=false', '--ssh=false']
state = subprocess.run(['tailscale', 'status', '--json'], text=True, capture_output=True)
if state.returncode == 0 and json.loads(state.stdout).get('BackendState') == 'Running':
    subprocess.run(command, check=True)
else:
    request = urllib.request.Request('http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token', headers={'Metadata-Flavor': 'Google'})
    with urllib.request.urlopen(request, timeout=30) as response:
        token = json.load(response)['access_token']
    request = urllib.request.Request('https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/${secret_id}/versions/latest:access', headers={'Authorization': 'Bearer ' + token})
    with urllib.request.urlopen(request, timeout=30) as response:
        key = base64.b64decode(json.load(response)['payload']['data'], validate=True)
    if not key.strip():
        raise SystemExit('The router auth secret is empty.')
    descriptor, path = tempfile.mkstemp(prefix='tailscale-auth-', dir='/run')
    try:
        with os.fdopen(descriptor, 'wb') as output:
            output.write(key.strip())
        subprocess.run(command + ['--auth-key=file:' + path], check=True)
    finally:
        os.unlink(path)
PY
